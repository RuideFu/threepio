QGroupBox#stripchart_control_group QLabel[role="readout"] {
    font-family: "Iosevka Aile";
    min-width: 56px;
    qproperty-alignment: AlignRight;
}

QGroupBox#stripchart_control_group QSlider::groove:horizontal {
    height: 4px;
}

QPushButton#channel_dual_button:checked {
    border-left: 4px solid #2196f3;
    border-right: 4px solid #ff5252;
}

QPushButton#channel_a_button:checked {
    border-left: 4px solid #2196f3;
    border-right: 4px solid transparent;
}

QPushButton#channel_b_button:checked {
    border-left: 4px solid transparent;
    border-right: 4px solid #ff5252;
}

QPushButton#channel_dual_button:!checked,
QPushButton#channel_a_button:!checked,
QPushButton#channel_b_button:!checked {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    color: #888;
}
